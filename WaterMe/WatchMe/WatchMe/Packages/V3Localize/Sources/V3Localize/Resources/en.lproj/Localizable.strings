/* Alert Message: Indicates there was an issue because iCloud reached a rate limit. */
"Sync couldn't be completed because of an iCloud rate limit. Syncing will automatically resume later." = "Sync couldn't be completed because of an iCloud rate limit. Syncing will automatically resume later.";

/* Alert Message: Indicates there was an issue because the user's iCloud storage is full. */
"Sync failed because your iCloud storage is full. You can buy more iCloud storage, delete data in iCloud, or disable iCloud sync for WaterMe in the settings app." = "Sync failed because your iCloud storage is full. You can buy more iCloud storage, delete data in iCloud, or disable iCloud sync for WaterMe in the settings app.";

/* Alert Message: Indicates there was a network error. Syncing will automatically resume when connected again. */
"Sync failed because there was a network error. Next time there is a network connection, sync will automatically resume." = "Sync failed because there was a network error. Next time there is a network connection, sync will automatically resume.";

/* Alert Message: Indicates some data was able to sync but not all. Syncing will resume again later. */
"Partial sync complete. Syncing will automatically resume later." = "Partial sync complete. Syncing will automatically resume later.";

/* Alert Message: Indicates something went wrong, but its not known why. Syncing will resume again later. */
"An unknown error ocurred. Syncing will automatically resume later." = "An unknown error ocurred. Syncing will automatically resume later.";

/* Alert Message: App could not detect iCloud login status. Very strange error, restarting device might help. */
"Unable to detect your iCloud account status. Turning your device off and on may resolve this issue." = "Unable to detect your iCloud account status. Turning your device off and on may resolve this issue.";

/* Alert Message: iCloud is restricted on this device. The user cannot fix this issue. */
"iCloud Sync is restricted by parental or administrator controls." = "iCloud Sync is restricted by parental or administrator controls.";

/* Alert Message: The user is not signed in with iCloud and therefore cannot use iCloud Sync with WaterMe. */
"To use iCloud Sync with WaterMe, please sign into your iCloud account and enable 'iCloud Drive.' If you do not want to see this error, disable 'Sync via iCloud' in Settings." = "To use iCloud Sync with WaterMe, please sign into your iCloud account and enable 'iCloud Drive.' If you do not want to see this error, disable 'Sync via iCloud' in Settings.";

/* Alert Message: The device is running an old version of iOS and cannot use iCloud Sync. */
