"iCloud Sync" = "iCloud Sync";

/* Cloud Sync Info: Body: Lets the user know how iCloud sync works and that it can be enabled and disabled from the settings app. */
"WaterMe now automatically syncs all plants and reminders via iCloud. You can enable and disable iCloud sync from the settings screen." = "WaterMe now automatically syncs all plants and reminders via iCloud. You can enable and disable iCloud sync from the settings screen.";

/* Alert Message: Indicates there was an issue with the password used for iCloud. This requires going to the phone's settings app. */
